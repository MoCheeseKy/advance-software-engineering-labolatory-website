// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql" 
}

generator client {
  provider = "prisma-client-js"
}

enum TipeMember {
  INTERN
  MEMBER
}

enum StatusRegistrasi {
  PENDING
  ACCEPTED
  REJECTED
}

model Fakultas {
  id_fakultas Int      @id @default(autoincrement())
  nama        String
  
  prodi       Prodi[]

  @@map("fakultas")
}

model Prodi {
  id_prodi    Int          @id @default(autoincrement())
  id_fakultas Int
  nama        String

  fakultas    Fakultas     @relation(fields: [id_fakultas], references: [id_fakultas])

  registrasi  Registrasi[]
  members     Member[]

  @@map("prodi") 
}

model Divisi {
  id_divisi   Int          @id @default(autoincrement())
  nama        String
  
  dataDivisi  DataDivisi[]
  
  pendaftarDiterima Registrasi[] @relation("DivisiDiterima")
  
  members     Member[]

  @@map("divisi")
}

model Registrasi {
  id_registrasi    Int      @id @default(autoincrement())
  id_prodi         Int
  nim              String  
  nama             String
  angkatan         Int
  cv               String   @db.Text
  motivationLetter String   @map("motivation-letter") @db.Text
  portofolio       String   @db.Text
  status           StatusRegistrasi @default(PENDING)
  id_divisi_diterima Int?

  divisiDiterima   Divisi?  @relation("DivisiDiterima", fields: [id_divisi_diterima], references: [id_divisi])
  prodi            Prodi    @relation(fields: [id_prodi], references: [id_prodi])
  
  dataDivisi       DataDivisi[]
  
  member           Member?

  @@map("registrasi")
}

model Member {
  id_member     Int         @id @default(autoincrement())
  id_registrasi Int?        @unique 
  
  nim           String      @unique 
  nama          String      
  angkatan      Int         
  id_prodi      Int         
  id_divisi     Int
  
  id_mentor     Int?    
  
  tipe_member   TipeMember  @default(INTERN) 
  
  registrasi    Registrasi? @relation(fields: [id_registrasi], references: [id_registrasi], onDelete: SetNull)
  prodi         Prodi       @relation(fields: [id_prodi], references: [id_prodi])
  divisi        Divisi      @relation(fields: [id_divisi], references: [id_divisi])
  mentor        Mentor?     @relation(fields: [id_mentor], references: [id_mentor], onDelete: SetNull)

  @@map("member")
}

model DataDivisi {
  id_divisi   Int
  id_register Int
  pilihan     Int    

  divisi      Divisi     @relation(fields: [id_divisi], references: [id_divisi])
  registrasi  Registrasi @relation(fields: [id_register], references: [id_registrasi])

  @@id([id_divisi, id_register])
  @@map("datadivisi")
}

model Admin {
  id_admin  Int         @id @default(autoincrement())
  email     String      @unique
  username  String      @unique
  password  String       
  role      String      @default("admin")

  blog      Blog[]
  product   Product[]

  @@map("admin")
}

model Blog{
  id_blog   Int         @id @default(autoincrement())
  id_admin  Int
  title     String
  authors   String[]
  url       String      @unique
  texts     String[]    
  images    String[]  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  admin     Admin       @relation(fields:[id_admin], references:[id_admin])
  
  @@map("blog")
}

model Product{
  id_product    Int     @id @default(autoincrement())
  id_admin      Int 
  name          String
  developers    String[]
  texts         String[]
  images        String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  admin         Admin    @relation(fields:[id_admin], references:[id_admin])

  @@map("product")
}

model SystemSetting {
  id        Int       @id @default(autoincrement())
  type      String    @unique
  isActive  Boolean   @default(false)
  startDate DateTime?
  endDate   DateTime?

  @@map("system_setting")
}

model Mentor {
  id_mentor    Int       @id @default(autoincrement())
  nama         String
  link_profile String?
  members      Member[]

  @@map("mentor")
}